pipeline {
    agent any

    environment {
        DEPLOY_USER = 'cloud-master-api'
        DEPLOY_HOST = 'server.zemation.com'
        DEPLOY_PATH = '/home/cloud-master-api/htdocs/api.cloud-master.io'
        APP_NAME    = 'cloud-api'
        NVM_DIR     = '/home/cloud-master-api/.nvm'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Deploy') {
            steps {
                dir('node-backend') {
                    sh '''
                        rsync -av \
                            --exclude='.env' \
                            --exclude='node_modules' \
                            . ${DEPLOY_USER}@${DEPLOY_HOST}:${DEPLOY_PATH}/
                    '''
                    sh """
                        ssh ${DEPLOY_USER}@${DEPLOY_HOST} '
                            export NVM_DIR=${NVM_DIR} &&
                            . \$NVM_DIR/nvm.sh &&
                            cd ${DEPLOY_PATH} &&
                            npm ci --omit=dev &&
                            pm2 restart ${APP_NAME} || pm2 start server.js --name ${APP_NAME} &&
                            pm2 save
                        '
                    """
                }
            }
        }
    }

    post {
        success {
            echo 'Backend deployed successfully!'
        }
        failure {
            echo 'Backend deployment failed!'
        }
    }
}
